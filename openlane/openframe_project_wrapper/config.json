        "dir::/../../verilog/rtl/openframe_project_wrapper.v"
    ],
    "VERILOG_FILES_BLACKBOX": [
        "dir::../../verilog/rtl/CF_CARAVEL_SOC.bb.v",
        "dir::../../verilog/rtl/counter_macro.bb.v",
        "dir::../../verilog/gl/vccd1_connection.v",
        "dir::../../verilog/gl/vssd1_connection.v"
    ],
    "EXTRA_LEFS": [
        "dir::../../lef/CF_CARAVEL_SOC.lef",
        "dir::../../lef/counter_macro.lef",
        "dir::../../lef/vccd1_connection.lef",
        "dir::../../lef/vssd1_connection.lef"
    ],
    "EXTRA_GDS_FILES": [
        "dir::../../gds/CF_CARAVEL_SOC.gds",
        "dir::../../gds/counter_macro.gds",
        "dir::../../gds/vccd1_connection.gds",
        "dir::../../gds/vssd1_connection.gds"
    ],
    "EXTRA_LIBS": "dir::../../lib/counter_macro.lib",
    "MAX_TRANSITION_CONSTRAINT": 0.5,
    "ERROR_ON_NL_ASSIGN_STATEMENTS": 0,
    "QUIT_ON_SYNTH_CHECKS": 0,
    "FP_PDN_CHECK_NODES": 0,
    "SYNTH_ELABORATE_ONLY": 1,
    "PL_RANDOM_GLB_PLACEMENT": 1,
    "SYNTH_USE_PG_PINS_DEFINES": "USE_POWER_PINS",
    "PL_RESIZER_DESIGN_OPTIMIZATIONS": 0,
    "PL_RESIZER_TIMING_OPTIMIZATIONS": 0,
    "GLB_RESIZER_TIMING_OPTIMIZATIONS": 0,
    "GLB_RESIZER_DESIGN_OPTIMIZATIONS": 0,
    "PL_RESIZER_BUFFER_INPUT_PORTS": 0,
    "RUN_CTS": 0,
    "FP_PDN_ENABLE_RAILS": 0,
    "// GRT_ALLOW_CONGESTION": "The SoC leaves ~123um channels either side of the die for the pad nets, so global routing always overflows; detailed routing resolves it.",
    "GRT_ALLOW_CONGESTION": 1,
    "GRT_REPAIR_ANTENNAS": 0,
    "RUN_HEURISTIC_DIODE_INSERTION": 0,
    "RUN_FILL_INSERTION": 0,
    "RUN_TAP_DECAP_INSERTION": 0,
    "// FP_PDN_?PITCH": "240 rather than the template's 40: CF_CARAVEL_SOC obstructs ~60% of met4/met5 over its footprint, and a 40um grid leaves no room for the pad nets.",
    "FP_PDN_VPITCH": 240,
    "FP_PDN_HPITCH": 240,
    "FP_PDN_VOFFSET": 18.43,
    "FP_PDN_HOFFSET": 22.83,
    "MAGIC_ZEROIZE_ORIGIN": 0,
    "FP_SIZING": "absolute",
    "RUN_CVC": 0,
    "FP_PDN_CORE_RING": 1,
    "FP_PDN_CORE_RING_VWIDTH": 20,
    "FP_PDN_CORE_RING_HWIDTH": 20,
    "FP_PDN_CORE_RING_VOFFSET": -4,
    "FP_PDN_CORE_RING_HOFFSET": -4,
    "FP_PDN_CORE_RING_VSPACING": 2.4,
    "FP_PDN_CORE_RING_HSPACING": 2.4,
    "FP_PDN_VWIDTH": 6.4,
    "FP_PDN_HWIDTH": 6.4,
    "FP_PDN_HSPACING": 3.2,
    "FP_PDN_VSPACING": 3.2,
    "VDD_NETS": [
        "vccd1"
    ],
    "GND_NETS": [
        "vssd1"
    ],
    "DIE_AREA": "0 0 3166.63 4766.630",
    "CORE_AREA": "40 40 3126.63 4726.630",
    "RUN_IRDROP_REPORT": 0,
    "FP_PDN_MACRO_HOOKS": "u_soc vccd1 vssd1 vccd vssd, u_counter vccd1 vssd1 VPWR VGND",
    "FP_PDN_CFG": "dir::pdn_cfg.tcl",
    "FP_DEF_TEMPLATE": "dir::fixed_dont_change/openframe_project_wrapper.def",
    "MACRO_PLACEMENT_CFG": "dir::macro.cfg",
    "RUN_LINTER": 0,
    "RUN_LVS": 0,
    "// Streamout": "Magic is the published GDS. KLayout streamout/XOR only compared the two writers (poly/licon/npc inside the macros) and is not used for tapeout.",
    "PRIMARY_GDSII_STREAMOUT_TOOL": "magic",
    "RUN_MAGIC_STREAMOUT": true,
    "RUN_KLAYOUT_STREAMOUT": false,
    "RUN_KLAYOUT_XOR": false,
    "MAGIC_DEF_LABELS": 0,
    "// MAGIC_EXT_ABSTRACT_CELLS": "Extract from the LEF abstracts: reading the SoC out of the final GDS takes hours and exhausts the container's memory.",
    "MAGIC_EXT_USE_GDS": false,
    "MAGIC_EXT_ABSTRACT_CELLS": ["^CF_CARAVEL_SOC$", "^counter_macro$"],
    "// ERROR_ON_ILLEGAL_OVERLAPS": "vccd1_connection/vssd1_connection carry a blanket met3 obstruction, so the PDN straps they exist to carry are reported as overlaps. Only the vccd1/vssd1 special nets reach them.",
    "ERROR_ON_ILLEGAL_OVERLAPS": false,
    "// ApplyDEFTemplate": "permissive because of a bug in LibreLane where the power pins have to be at least declared in strict mode.",
    "FP_TEMPLATE_COPY_POWER_PINS": true,
    "FP_TEMPLATE_MATCH_MODE": "permissive",
    "// CustomApplyDEFTemplate": "deprecated, for use with the plugin",
    "FP_TEMPLATE_PINS": [
        "vccd1",
        "vssd1",
        "vccd",
        "vssd",
        "vccd2",
        "vssd2",
        "vssa",
        "vdda",
        "vssa1",
        "vdda1",
        "vssa2",
        "vdda2",
        "vddio",
        "vssio"
    ]
}
